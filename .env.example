# stripenav example configuration — copy to .env and fill in.
#
# Do NOT surround values with quotes ("foo", 'bar'). Docker's
# --env-file parser keeps quote characters as part of the value, which
# breaks fixed-length validators (notably NAV_EXCHANGE_KEY, which must
# be exactly 16 bytes). Both godotenv (used by the Taskfile) and Docker
# accept unquoted values containing spaces, accents, hyphens, and dots.

# --- Stripe ---
# Endpoint signing secret from the Stripe dashboard (whsec_…).
STRIPE_WEBHOOK_SECRET=

# --- NAV ---
# Test endpoint until your technical user is verified.
NAV_BASE_URL=https://api-test.onlineszamla.nav.gov.hu/invoiceService/v3

NAV_LOGIN=
NAV_PASSWORD=
NAV_TAX_NUMBER=
NAV_SIGN_KEY=
# Must be exactly 16 bytes (AES-128).
NAV_EXCHANGE_KEY=

# EXACTLY 18 chars, uppercase A-Z, 0-9, and '-' only.
# NAV recommendation:
#   - first 2 chars: developer country code (ISO 3166 alpha-2)
#   - next chars: developer tax-number base (8 digits for HU)
#   - remaining chars: serial of your choice
# Example: HU 12345678 STRIPNAV  (2 + 8 + 8 = 18).
NAV_SOFTWARE_ID=HU00000000STRIPNAV
NAV_DEV_NAME=
NAV_DEV_CONTACT=

# --- Supplier (the merchant issuing the invoice) ---
SUPPLIER_TAX_NUMBER=
SUPPLIER_NAME=
SUPPLIER_COUNTRY=HU
SUPPLIER_POSTAL_CODE=
SUPPLIER_CITY=
SUPPLIER_ADDRESS=

# --- Persistence ---
# Empty (or "memory:") → in-memory, lossy on restart.
# postgres://user:password@host:port/dbname?sslmode=... → Postgres.
STORE_URL=

# --- Server ---
LISTEN_ADDR=:8080

# Worker pacing. The worker wakes on a signal from the webhook handler
# (a freshly-stored row) or after WORKER_MAX_SLEEP, whichever comes
# first. WORKER_POLL_INTERVAL is the in-flight gap between NAV status
# polls. Leave unset to use library defaults.
# WORKER_MAX_SLEEP=10s
# WORKER_POLL_INTERVAL=5s

# Claim lease TTL. A claimed row is released back to the pool if the
# owning worker doesn't renew within this window — protects against
# crashed replicas. Leave unset for the library default (60s).
# WORKER_LEASE_DURATION=60s

# Identifies this replica when claiming rows. Unset → a random id is
# generated at startup. Set to a stable per-replica value (e.g. the
# pod name) if you want claims to be greppable in logs.
# WORKER_CLAIMER_ID=

# Set to "true" to log every outbound NAV request and inbound response.
# Local debugging only — bodies include the signed envelope.
NAV_DEBUG=false
